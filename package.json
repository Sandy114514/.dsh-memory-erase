{
    "name":  "@local/dsh-memory-erase",
    "version":  "1.0.2",
    "description":  "Plastic Memories style memory-erase protocol: detects a marked removable drive, asks before erasing the displayed Session, and returns a blank one.",
    "type":  "module",
    "license":  "MIT",
    "keywords":  [
                     "dsh",
                     "dsh-plugin",
                     "deepseek-harness",
                     "cordis",
                     "plastic-memories",
                     "memory-erase",
                     "usb",
                     "removable-drive"
                 ],
    "exports":  {
                    ".":  "./index.js",
                    "./client":  "./client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg"
                },
    "files":  [
                  "index.js",
                  "client.js",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg",
                  "README.md",
                  "LICENSE"
              ],
    "icon":  "icon.svg",
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-conversation",
                                              "@deepseek-ai/dsh-api-remotes"
                                          ]
                           }
            }
}
